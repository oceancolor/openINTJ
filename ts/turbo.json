{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".turbo/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "__tests__/**", "vitest.config.ts"],
      "env": [
        "OPENINTJ_E2E",
        "OPENINTJ_DATA_DIR",
        "OPENINTJ_DESKTOP_NO_PERSIST",
        "OPENINTJ_LANCE_DEBUG"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "@openintj/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "release/**"]
    }
  }
}
