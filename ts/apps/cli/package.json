{
  "name": "@openintj/cli",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "OpenINTJ 终端版（开发/调试用）",
  "main": "./dist/index.js",
  "bin": {
    "openintj": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openintj/channels": "workspace:*",
    "@openintj/classifier": "workspace:*",
    "@openintj/concurrency": "workspace:*",
    "@openintj/connectors": "workspace:*",
    "@openintj/core": "workspace:*",
    "@openintj/dormant": "workspace:*",
    "@openintj/identity": "workspace:*",
    "@openintj/llm-hunyuan": "workspace:*",
    "@openintj/llm-ollama": "workspace:*",
    "@openintj/model-runtime": "workspace:*",
    "@openintj/plane-control": "workspace:*",
    "@openintj/plane-execution": "workspace:*",
    "@openintj/plane-governance": "workspace:*",
    "@openintj/plane-memory": "workspace:*",
    "@openintj/profile": "workspace:*",
    "@openintj/runtime": "workspace:*",
    "@openintj/scheduler": "workspace:*",
    "@openintj/shared": "workspace:*",
    "@openintj/skills": "workspace:*",
    "@openintj/sync": "workspace:*",
    "@openintj/taskpool": "workspace:*",
    "@openintj/voice": "workspace:*",
    "commander": "^12.1.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
