{
  "name": "@openintj/desktop",
  "version": "3.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "OpenINTJ Electron 桌面客户端（Win/Mac local-first）",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:win": "electron-vite build && electron-builder --config electron-builder.yml --win",
    "package:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "electron-vite build && playwright test --config=e2e/playwright.config.ts",
    "e2e:run": "playwright test --config=e2e/playwright.config.ts",
    "clean": "rimraf out dist release .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.13.0",
    "@openintj/concurrency": "workspace:*",
    "@openintj/core": "workspace:*",
    "@openintj/dormant": "workspace:*",
    "@openintj/llm-hunyuan": "workspace:*",
    "@openintj/llm-ollama": "workspace:*",
    "@openintj/plane-control": "workspace:*",
    "@openintj/plane-execution": "workspace:*",
    "@openintj/plane-governance": "workspace:*",
    "@openintj/plane-memory": "workspace:*",
    "@openintj/shared": "workspace:*",
    "@openintj/storage-lance": "workspace:*",
    "@openintj/storage-sqlite": "workspace:*",
    "@openintj/taskpool": "workspace:*",
    "@openintj/telemetry-otel": "workspace:*",
    "apache-arrow": "^17.0.0",
    "better-sqlite3": "^11.0.0",
    "electron-updater": "^6.3.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
