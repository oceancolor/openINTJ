{
  "name": "openintj",
  "version": "0.3.0",
  "private": true,
  "description": "OpenINTJ v0.3 — TS-first agent framework with Electron local-first desktop client",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "desktop:dev": "pnpm --filter @openintj/desktop dev",
    "desktop:build": "pnpm --filter @openintj/desktop build",
    "desktop:package": "pnpm --filter @openintj/desktop package",
    "cli": "pnpm --filter @openintj/cli start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.16.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
