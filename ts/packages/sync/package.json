{
  "name": "@openintj/sync",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "RFC-019 cross-device sync bundle v1: profile (LWW + tombstones), schedule union, and RFC-020 identity graph union merge",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openintj/identity": "workspace:*",
    "@openintj/profile": "workspace:*",
    "@openintj/scheduler": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
