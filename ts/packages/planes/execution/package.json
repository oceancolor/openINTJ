{
  "name": "@openintj/plane-execution",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Execution Plane: ToolHub + AgentPool + 线程原语",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openintj/core": "workspace:*",
    "@openintj/shared": "workspace:*",
    "docx": "^9.16.0",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "jszip": "^3.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
