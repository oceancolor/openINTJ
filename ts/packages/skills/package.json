{
  "name": "@openintj/skills",
  "version": "3.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "技能系统：作者编写的 SKILL.md 能力包，两级（目录 + 嵌入检索）按需注入，opt-in 降 token；为自学习技能预留可插拔 SkillSource",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "skills"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openintj/core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
