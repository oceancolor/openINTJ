{
  "name": "@openintj/taskpool",
  "version": "0.3.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "RFC-003 retrieval primitives and RFC-007 opt-in bounded task orchestration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openintj/concurrency": "workspace:*",
    "@openintj/core": "workspace:*",
    "@openintj/plane-control": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
