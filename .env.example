# ============================================================
# OpenINTJ 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 填写必要的配置项（至少填写 HUNYUAN_API_KEY）
#   3. 启动服务时会自动加载 .env 文件中的配置
# ============================================================

# [可选] LLM 提供方：auto（仅 Ollama → Hunyuan → mock）| ollama | hunyuan | kimi | minimax | glm | mock
LLM_PROVIDER=auto

# [可选] Embedding 提供方：auto | simple | ollama | xenova | mock
EMBEDDING_PROVIDER=auto

# ------ Ollama 本地模型（LLM_PROVIDER=auto|ollama 时使用） ------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# [可选] SimpleEmbedder 维度（EMBEDDING_PROVIDER=mock 或 auto 回退时）
# OPENINTJ_EMBED_DIM=64

# ------ 可选特性开关 ------
# Product Behavior 默认开启；A/B 基线（control）设为 0。
# OPENINTJ_PRODUCT_BEHAVIOR=0
# 前端分类器可独立启用；TaskPool 开启时会自动启用，不必重复配置。
# OPENINTJ_CLASSIFIER=1
# RFC-007：仅 planning/analysis；默认关闭。开启后会自动启用其必需的 classifier。
# CLI 仅内存运行、不做重启恢复；server/desktop + real data dir 才启用 SQLite run snapshots。
# OPENINTJ_TASK_POOL=1
# 重启时默认把遗留 running run 标记 cancelled，避免重复外部副作用。
# 仅在 worker 操作可安全重放时显式设为 resume。
# OPENINTJ_TASK_POOL_RECOVERY=resume

# ------ 腾讯混元大模型配置 ------

# [必填] 混元 API 密钥
# 获取方式：登录腾讯云控制台 → 混元大模型 → API 密钥管理
HUNYUAN_API_KEY=your_api_key_here

# [可选] 混元 TokenHub OpenAI-compatible 基础地址（默认值如下）
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1

# [可选] 对话模型名称（官方 Hy3 模型 ID）
HUNYUAN_MODEL=hy3

# [可选] 视觉模型名称（用于图片理解，默认使用 hunyuan-vision）
HUNYUAN_VISION_MODEL=hunyuan-vision

# ------ OpenAI-compatible 云模型（均为显式 opt-in，缺 key 时 fail-closed） ------

# Kimi（LLM_PROVIDER=kimi）
# KIMI_API_KEY=your_kimi_api_key
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k2.5

# MiniMax（LLM_PROVIDER=minimax）
# MINIMAX_API_KEY=your_minimax_api_key
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M2.1

# 智谱 GLM（LLM_PROVIDER=glm）
# GLM_API_KEY=your_glm_api_key
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4.7

# ------ 外部联网搜索（provider 中立，推荐 TokenHub 用户用这个） ------
# 背景：腾讯混元旧平台内建联网搜索已随平台 2026-06-22 下线，TokenHub 把搜索改成独立的
# Responses API 产品。OpenINTJ 走「Function Calling + 外部搜索后端」恢复 search 能力——
# 配好 key 后，模型调用 search 工具时由 Tavily / Brave 返回真实结果。
# - 不配 key → 不挂外部搜索（零开销）。
# - provider 可显式指定，也可只填对应 key 自动推断（Tavily 优先于 Brave）。
# OPENINTJ_SEARCH_PROVIDER=tavily            # tavily | brave（可选，留空按已配置 key 推断）
# OPENINTJ_SEARCH_API_KEY=your_search_key    # 通用 key（配合 OPENINTJ_SEARCH_PROVIDER）
# TAVILY_API_KEY=tvly-xxx                     # 或直接给 provider-specific key
# BRAVE_API_KEY=BSA-xxx

# ------ 混元内建联网搜索（旧平台；TokenHub 上已失效，仅 api.hunyuan.cloud.tencent.com 有效） ------
# 开启后，模型回复会接入腾讯混元的实时联网搜索（对应 OpenAI 兼容端点的 enable_enhancement）。
# 注意：自 2025-04-20 起官方默认关闭；hunyuan-lite 无此能力；TokenHub 用上面的外部搜索替代。
# 取值 1 / true 开启，留空或 0 关闭。
HUNYUAN_ENABLE_SEARCH=0

# [可选] 强制走 AI 搜索（force_search_enhancement）；开启时自动隐含开启联网搜索。
HUNYUAN_FORCE_SEARCH=0

# [可选] 命中搜索时返回来源信息（search_info），可通过 client.lastSearchSources 读取。
HUNYUAN_SEARCH_INFO=0

# [可选] 引文角标（citation），需配合 HUNYUAN_ENABLE_SEARCH + HUNYUAN_SEARCH_INFO。
HUNYUAN_CITATION=0
